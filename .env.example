# ═══════════════════════════════════════════
# Переменные окружения серверной части (Cloudflare Worker).
#
# ЭТОТ ФАЙЛ — ТОЛЬКО ОБРАЗЕЦ. Значений здесь нет и быть не должно.
# Настоящие ключи задаются командой (значение вводится в консоли,
# в файлы не попадает и в репозиторий не уезжает):
#
#     cd api
#     wrangler secret put ИМЯ_ПЕРЕМЕННОЙ
#
# ═══════════════════════════════════════════

# ── Telegram ──
# Токен от @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Куда слать заявки: ваш id или id беседы (с минусом)
TELEGRAM_CHAT_ID=

# ── ВКонтакте ──
# Ключ доступа сообщества с правом «Сообщения»
# Управление сообществом → Работа с API → Ключи доступа
VK_TOKEN=
# Куда слать: ваш user id, либо 2000000000 + id беседы
VK_PEER_ID=
# Строка подтверждения из Callback API сообщества
VK_CONFIRMATION=
# Секретный ключ Callback API (придумываете сами, вписываете в двух местах)
VK_SECRET=

# ── ЮKassa ──
# Появятся после регистрации магазина. Пока пусты — работает демо-оплата.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ── Не секрет, задаётся в api/wrangler.toml ──
# ALLOWED_ORIGINS=https://ваш-домен.ru
